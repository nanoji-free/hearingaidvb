<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- アプリ全体のベーステーマ -->
    <style name="Base.Theme.HearingAidVb" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="alertDialogTheme">@style/MyAlertDialogTheme</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:textColor">@color/white</item>
        <item name="materialButtonStyle">@style/MyButtonStyle</item>
    </style>
    <style name="MyButtonStyle" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/black</item>
    </style>
    <style name="Theme.HearingAidVb" parent="Base.Theme.HearingAidVb" />

    <!-- 標準 AlertDialog の黒背景＋白文字テーマ -->
    <style name="MyAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#000000</item>        <!-- 背景（黒） -->
        <item name="colorOnSurface">#FFFFFF</item>      <!-- 文字（白） -->
        <item name="android:textColor">#FFFFFF</item>   <!-- タイトルなど -->
    </style>




    <!-- スプラッシュ専用テーマ -->
    <style name="Theme.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- ↑　仮設画像を背景にするなら「@drawable/sumple_splash</item>」に差し替え -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>


