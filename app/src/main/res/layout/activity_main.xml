<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@color/dialog_background">

    <TextView
        android:id="@+id/topOfPageBlanker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <Button
        android:id="@+id/toggleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="開始"
        app:layout_constraintTop_toBottomOf="@+id/topOfPageBlanker"
        />
    <SeekBar
        android:id="@+id/volumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="4dp"
        android:thumb="@drawable/custom_thumb"
        android:max="100"
        app:layout_constraintTop_toBottomOf="@+id/toggleButton"
        />
    <TextView
        android:id="@+id/tvVolumeValue"
        android:layout_width="160dp"
        android:layout_height="30dp"
        android:layout_marginTop="54dp"
        android:text="音量調整"
        android:textSize="18dp"
        app:layout_constraintTop_toBottomOf="@+id/toggleButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginStart="16dp"
        />
    <Button
        android:id="@+id/button_moresettings"
        android:layout_width="128dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="さらに調整"
        app:layout_constraintTop_toBottomOf="@+id/toggleButton"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <Button
        android:id="@+id/button_easysettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="かんたん設定へ"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_moresettings"
        />


        <ImageView
            android:id="@+id/centerImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="72dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:maxWidth="160dp"
            android:maxHeight="160dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toBottomOf="@+id/button_easysettings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <ImageView
        android:id="@+id/up_msg_bord"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/up_msg_bord"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"

        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/button_easysettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

    />
<!--　↑　android:layout_marginStart="32dp"　の値で左右の余白の大きさを変更
        android:layout_marginEnd="32dp"　の値で横幅が変わる　 -->

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="動作停止中"
        android:textColor="#e95464"
        android:textSize="25sp"
        android:layout_margin="18dp"
        app:layout_constraintTop_toTopOf="@+id/up_msg_bord"
        app:layout_constraintStart_toStartOf="@+id/up_msg_bord"
        app:layout_constraintEnd_toEndOf="@+id/up_msg_bord"
        />

    <Button
        android:id="@+id/toInfoButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="お知らせ など"
        app:layout_constraintTop_toBottomOf="@+id/centerImage"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <!-- クラッシュボタンはテスト用なので、不使用時はコメントアウト
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/crashButton"
        android:text="crush Button(for Test Of FIREBASE)"
        app:layout_constraintTop_toBottomOf="@+id/button_easysettings"
        />
    -->

        <TextView
            android:id="@+id/textOfNoiseFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ノイズ除去（搭載スマホのみ対応）"
            android:layout_margin="8dp"
            app:layout_constraintTop_toBottomOf="@id/toInfoButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/noiseFilterSwitch" />

        <Switch
            android:id="@+id/noiseFilterSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="@id/textOfNoiseFilter"
            app:layout_constraintBottom_toBottomOf="@id/textOfNoiseFilter"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/textOfEmphasis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ノイズ低減＆音声クリア"
            android:layout_margin="8dp"
            app:layout_constraintTop_toBottomOf="@id/textOfNoiseFilter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/emphasisSwitch" />

        <Switch
            android:id="@+id/emphasisSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="@id/textOfEmphasis"
            app:layout_constraintBottom_toBottomOf="@id/textOfEmphasis"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/presetButtonMA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="設定リセット"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/emphasisSwitch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_settings" />

        <Button
            android:id="@+id/button_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="詳細設定へ"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/emphasisSwitch"
            app:layout_constraintStart_toEndOf="@id/presetButtonMA"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>


